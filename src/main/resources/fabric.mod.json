{
  "schemaVersion": 1,
  "id": "clientlocate",
  "version": "${version}",
  "name": "ClientLocate",
  "description": "Client-side /clocate without operator rights, plus a built-in seed cracker: find the world seed, then locate structures and biomes from it, including those added by mods and datapacks.",
  "authors": [
    "ClientLocate contributors",
    "KaptainWutax (SeedCrackerX)",
    "19MisterX98 (SeedCrackerX)"
  ],
  "contact": {
    "homepage": "https://github.com/micahmelendez/ClientLocate",
    "sources": "https://github.com/micahmelendez/ClientLocate",
    "issues": "https://github.com/micahmelendez/ClientLocate/issues"
  },
  "license": "MIT",
  "icon": "assets/seedcrackerx/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "kaptainwutax.seedcrackerX.SeedCracker"
    ],
    "seedcrackerx": [
      "dev.clientlocate.CrackerBridge"
    ],
    "client": [
      "dev.clientlocate.ClientLocate"
    ],
    "modmenu": [
      "kaptainwutax.seedcrackerX.config.ScModMenuEntry"
    ]
  },
  "mixins": [
    "seedcracker.mixins.json",
    "clientlocate.mixins.json"
  ],
  "provides": [
    "seedcrackerx"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*",
    "flamingo": "*"
  }
}
